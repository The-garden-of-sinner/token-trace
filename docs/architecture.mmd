flowchart TB
    A["WorkBuddy<br/>projects/**/*.jsonl + db<br/><small>token · 积分 · 上下文块</small>"]
    B["Codex<br/>sessions/**/rollout-*.jsonl[.zst]<br/><small>token · 工具 · 轮次</small>"]
    C["ZCode<br/>cli/db/db.sqlite<br/><small>token · 工具 · 会话</small>"]
    D["DSH<br/>session.v4.jsonl.zstd<br/><small>usage · 多帧事件流</small>"]

    A -->|只读| E
    B -->|只读| E
    C -->|只读| E
    D -->|只读| E

    E["sources/bridge.py · 统一入口<br/><small>scan_all() 合并四源摘要 · build(src://sid) 分发<br/>归一成同一套 ctx[] / calls[]</small>"]

    E -->|一次解析，派生索引一次算好| F

    subgraph L1["① 数据层 · build(path, full=True) + Store 常驻"]
        F["全文常驻 · 每块一个 URL<br/>pref[] / ctxns[] / vfs[]<br/>acc[k] 按类型前缀和 · 压缩感知 [vf, ctxN)"]
    end

    F --> G

    subgraph L2["② 计算层 · 重活全在后端"]
        G["call_state O(1) · call_outline · block_users<br/>find_blocks · search · trend_rows<br/>tool_stats · compact_rows · clamp_p"]
    end

    G -->|一屏 HTML| H
    G -->|一条 JSON| I

    subgraph L3["③ 输出层"]
        H["HTML 渲染层<br/>page() 统一外壳 · 10–67 KB/页<br/>零 script · a href + details"]
        I["JSON API 层<br/>18 个端点 · {ok, data, meta}<br/>offset/limit 分页 · Range 语义"]
    end

    H --> J["浏览器（零 JS / 零构建）· 脚本 curl"]
    I --> J

